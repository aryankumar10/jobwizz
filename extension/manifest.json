{
  "manifest_version": 3,
  "name": "JobWizz",
  "version": "1.1.0",
  "description": "Smart Job Application Tracker with AI Auto-Capture for LinkedIn, Handshake, and Career Sites",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "*://*.linkedin.com/*",
    "*://*.joinhandshake.com/*",
    "*://app.joinhandshake.com/*",
    "*://*.indeed.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JobWizz - Job Tracker"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/jobs/*"],
      "js": ["content/linkedin-extractor.js"]
    },
    {
      "matches": [
        "*://*.joinhandshake.com/*",
        "*://app.joinhandshake.com/*",
        "*://*.joinhandshake.com/jobs/*",
        "*://*.joinhandshake.com/stu/jobs/*"
      ],
      "js": ["content/handshake-extractor.js"]
    },
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*"
      ],
      "js": ["content/generic-extractor.js"]
    }
  ]
}
